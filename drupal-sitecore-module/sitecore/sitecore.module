<?php

/**
 * @file
 * Contains sitecore.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function sitecore_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the sitecore module.
    case 'help.page.sitecore':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Sitecore Migration Module') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_theme().
 */
function sitecore_theme() {
  return [
    'sitecore' => [
      'render element' => 'children',
    ],
  ];
}
